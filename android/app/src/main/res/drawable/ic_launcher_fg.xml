<?xml version="1.0" encoding="utf-8"?>
<!-- RokeBox launcher icon: the panel's faceplate (the background colour, ic_bg) with a display window cut into it, a white
     "R" and a rose lamp in the window, and the panel's page scale under it with the current page lit. The same mark as
     tools/make-icon.ps1 (Windows) and the web pages; drawn on a 64-unit grid and scaled into the adaptive icon's safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.25"
        android:scaleY="1.25"
        android:translateX="14"
        android:translateY="13">
        <!-- display window -->
        <path
            android:pathData="M17,11h30a6,6 0,0 1,6 6v19a6,6 0,0 1,-6 6h-30a6,6 0,0 1,-6 -6v-19a6,6 0,0 1,6 -6z"
            android:fillColor="#090B0E" />
        <!-- light catching the window's lower edge -->
        <path
            android:pathData="M14,42.5h36"
            android:strokeWidth="1"
            android:strokeColor="#1FFFFFFF" />
        <!-- R -->
        <path android:pathData="M21,17h4.6v19h-4.6z" android:fillColor="#EEF1F4" />
        <path
            android:pathData="M23.3,19.2h7.6a4.6,4.6 0,0 1,0 9.2h-7.6"
            android:strokeWidth="4.6"
            android:strokeColor="#EEF1F4"
            android:fillColor="#00000000" />
        <path
            android:pathData="M30.2,30l6.2,6.6"
            android:strokeWidth="4.6"
            android:strokeColor="#EEF1F4"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- lamp -->
        <path android:pathData="M43.1,18a2.4,2.4 0,1 0,4.8 0a2.4,2.4 0,1 0,-4.8 0z" android:fillColor="#FB7185" />
        <!-- page scale -->
        <path
            android:pathData="M22,49v4M27,49v4M37,49v4M42,49v4"
            android:strokeWidth="1.8"
            android:strokeColor="#5C636E"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M32,47.5v7"
            android:strokeWidth="2.2"
            android:strokeColor="#FB7185"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
